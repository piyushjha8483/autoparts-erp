// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(SALES_USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMERS (Garages / Automobile Dealers)
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id            Int      @id @default(autoincrement())
  companyName   String   @map("company_name") @db.VarChar(200)
  contactPerson String   @map("contact_person") @db.VarChar(100)
  mobile        String   @db.VarChar(20)
  email         String?  @db.VarChar(150)
  city          String   @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  enquiries   Enquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]

  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCTS (Automobile Spare Parts)
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id        Int      @id @default(autoincrement())
  partCode  String   @unique @map("part_code") @db.VarChar(50)
  partName  String   @map("part_name") @db.VarChar(200)
  category  String   @db.VarChar(100)
  unit      String   @db.VarChar(30)
  basePrice Decimal  @map("base_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inventory      Inventory?
  enquiryItems   EnquiryItem[]
  quotationItems QuotationItem[]
  salesOrderItems SalesOrderItem[]
  dispatchItems  DispatchItem[]

  @@map("products")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY (Spare Parts Stock)
// ─────────────────────────────────────────────────────────────────────────────

model Inventory {
  productId   Int     @id @map("product_id")
  physicalQty Decimal @default(0) @map("physical_qty") @db.Decimal(12, 2)
  reservedQty Decimal @default(0) @map("reserved_qty") @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Ensure quantities are never negative at DB level
  @@map("inventory")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENQUIRIES (Spare Parts Enquiries)
// ─────────────────────────────────────────────────────────────────────────────

model Enquiry {
  id             Int           @id @default(autoincrement())
  enquiryNumber  String        @unique @map("enquiry_number") @db.VarChar(50)
  customerId     Int           @map("customer_id")
  enquiryDate    DateTime      @default(now()) @map("enquiry_date") @db.Date
  requiredDate   DateTime?     @map("required_date") @db.Date
  notes          String?       @db.Text
  status         EnquiryStatus @default(NEW)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  customer      Customer      @relation(fields: [customerId], references: [id])
  enquiryItems  EnquiryItem[]
  quotations    Quotation[]

  @@map("enquiries")
}

model EnquiryItem {
  id         Int     @id @default(autoincrement())
  enquiryId  Int     @map("enquiry_id")
  productId  Int     @map("product_id")
  quantity   Decimal @db.Decimal(12, 2)

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("enquiry_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// QUOTATIONS (Parts Quotations)
// ─────────────────────────────────────────────────────────────────────────────

model Quotation {
  id              Int             @id @default(autoincrement())
  quotationNumber String          @unique @map("quotation_number") @db.VarChar(50)
  enquiryId       Int             @map("enquiry_id")
  customerId      Int             @map("customer_id")
  validUntil      DateTime?       @map("valid_until") @db.Date
  status          QuotationStatus @default(DRAFT)
  // Grand total is always calculated by backend; stored here for reference
  grandTotal      Decimal         @default(0) @map("grand_total") @db.Decimal(14, 2)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  enquiry        Enquiry         @relation(fields: [enquiryId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  quotationItems QuotationItem[]
  salesOrder     SalesOrder?

  @@map("quotations")
}

model QuotationItem {
  id           Int     @id @default(autoincrement())
  quotationId  Int     @map("quotation_id")
  productId    Int     @map("product_id")
  quantity     Decimal @db.Decimal(12, 2)
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  discountPct  Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  gstPct       Decimal @default(18) @map("gst_pct") @db.Decimal(5, 2)
  // lineAmount = quantity * unitPrice * (1 - discount/100) * (1 + gst/100)
  // Calculated and stored by backend
  lineAmount   Decimal @default(0) @map("line_amount") @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("quotation_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// SALES ORDERS (Spare Parts Sales Orders)
// ─────────────────────────────────────────────────────────────────────────────

model SalesOrder {
  id           Int              @id @default(autoincrement())
  orderNumber  String           @unique @map("order_number") @db.VarChar(50)
  // Unique constraint on quotationId prevents duplicate Sales Orders per Quotation
  quotationId  Int              @unique @map("quotation_id")
  customerId   Int              @map("customer_id")
  orderDate    DateTime         @default(now()) @map("order_date") @db.Date
  totalAmount  Decimal          @map("total_amount") @db.Decimal(14, 2)
  status       SalesOrderStatus @default(PENDING)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  quotation       Quotation        @relation(fields: [quotationId], references: [id])
  customer        Customer         @relation(fields: [customerId], references: [id])
  salesOrderItems SalesOrderItem[]
  dispatch        Dispatch?

  @@map("sales_orders")
}

model SalesOrderItem {
  id           Int     @id @default(autoincrement())
  salesOrderId Int     @map("sales_order_id")
  productId    Int     @map("product_id")
  quantity     Decimal @db.Decimal(12, 2)
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  lineAmount   Decimal @map("line_amount") @db.Decimal(14, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@map("sales_order_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// DISPATCHES (Parts Dispatches)
// ─────────────────────────────────────────────────────────────────────────────

model Dispatch {
  id             Int      @id @default(autoincrement())
  dispatchNumber String   @unique @map("dispatch_number") @db.VarChar(50)
  // One dispatch per sales order; unique prevents duplicate dispatches
  salesOrderId   Int      @unique @map("sales_order_id")
  dispatchDate   DateTime @default(now()) @map("dispatch_date") @db.Date
  vehicleNumber  String?  @map("vehicle_number") @db.VarChar(50)
  driverName     String?  @map("driver_name") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")

  salesOrder    SalesOrder     @relation(fields: [salesOrderId], references: [id])
  dispatchItems DispatchItem[]

  @@map("dispatches")
}

model DispatchItem {
  id         Int     @id @default(autoincrement())
  dispatchId Int     @map("dispatch_id")
  productId  Int     @map("product_id")
  quantity   Decimal @db.Decimal(12, 2)

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("dispatch_items")
}
